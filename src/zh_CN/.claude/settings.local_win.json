{
 "_description": {
    "system": "WINDOWS 系统"
  },
  "alwaysThinkingEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\unified-hook.py\"",
            "statusMessage": "检查权限..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\unified-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\unified-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}